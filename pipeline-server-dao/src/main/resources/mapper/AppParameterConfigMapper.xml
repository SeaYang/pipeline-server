<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ci.pipeline.dao.mapper.AppParameterConfigMapper">

    <resultMap id="BaseResultMap" type="com.ci.pipeline.dao.entity.AppParameterConfig">
        <id column="id" property="id"/>
        <result column="app_name" property="appName"/>
        <result column="parameter_name" property="parameterName"/>
        <result column="value" property="value"/>
        <result column="env" property="env"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, app_name, parameter_name, value, env, create_time, update_time, deleted
    </sql>

    <select id="selectByAppParamEnv" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM app_parameter_config
        WHERE deleted = 0
          AND app_name = #{appName}
          AND parameter_name = #{parameterName}
          AND env = #{env}
        LIMIT 1
    </select>

    <select id="countByAppParamEnv" resultType="long">
        SELECT COUNT(*)
        FROM app_parameter_config
        WHERE deleted = 0
          AND app_name = #{appName}
          AND parameter_name = #{parameterName}
          AND env = #{env}
        <if test="excludeId != null">
            AND id &lt;&gt; #{excludeId}
        </if>
    </select>

    <select id="selectListByAppEnv" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM app_parameter_config
        WHERE deleted = 0
          AND app_name = #{appName}
          AND env = #{env}
        ORDER BY id DESC
    </select>
</mapper>
