<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ci.pipeline.dao.mapper.DictDataMapper">

    <resultMap id="BaseResultMap" type="com.ci.pipeline.dao.entity.DictData">
        <id column="id" property="id"/>
        <result column="dict_type" property="dictType"/>
        <result column="dict_key" property="dictKey"/>
        <result column="dict_value" property="dictValue"/>
        <result column="dict_sort" property="dictSort"/>
        <result column="remark" property="remark"/>
        <result column="enabled" property="enabled"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, dict_type, dict_key, dict_value, dict_sort, remark, enabled, create_time, update_time, deleted
    </sql>

    <!-- 自定义查询不会被 MyBatis-Plus 逻辑删除插件自动追加 deleted 条件，需手动指定 deleted = 0 -->
    <select id="selectByTypeAndKey" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM dict_data
        WHERE deleted = 0
          AND dict_type = #{dictType}
          AND dict_key = #{dictKey}
        LIMIT 1
    </select>

    <select id="countByTypeAndKey" resultType="long">
        SELECT COUNT(*)
        FROM dict_data
        WHERE deleted = 0
          AND dict_type = #{dictType}
          AND dict_key = #{dictKey}
        <if test="excludeId != null">
            AND id &lt;&gt; #{excludeId}
        </if>
    </select>

    <select id="countByDictType" resultType="long">
        SELECT COUNT(*)
        FROM dict_data
        WHERE deleted = 0
          AND dict_type = #{dictType}
    </select>

    <select id="listByDictType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM dict_data
        WHERE deleted = 0
          AND dict_type = #{dictType}
        ORDER BY dict_sort ASC, id ASC
    </select>

    <!-- 分页由 MyBatis-Plus 分页插件自动改写，这里无需手写 LIMIT -->
    <!--
        排序字段使用 ${} 拼接：sortField 为 Service 层白名单映射后的 snake_case 列名，
        sortOrder 限定为 asc / desc，均不可由前端直接控制，杜绝 SQL 注入。
    -->
    <select id="pageQuery" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM dict_data
        <where>
            deleted = 0
            <if test="dictType != null and dictType != ''">
                AND dict_type = #{dictType}
            </if>
            <if test="dictKey != null and dictKey != ''">
                AND dict_key LIKE CONCAT('%', #{dictKey}, '%')
            </if>
            <if test="dictValue != null and dictValue != ''">
                AND dict_value LIKE CONCAT('%', #{dictValue}, '%')
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="sortField != null and sortField != ''">
                ${sortField} ${sortOrder}, id DESC
            </when>
            <otherwise>
                dict_sort ASC, id ASC
            </otherwise>
        </choose>
    </select>

</mapper>
