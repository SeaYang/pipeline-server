<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ci.pipeline.dao.mapper.AppInfoMapper">

    <resultMap id="BaseResultMap" type="com.ci.pipeline.dao.entity.AppInfo">
        <id column="id" property="id"/>
        <result column="app_name" property="appName"/>
        <result column="programming_language" property="programmingLanguage"/>
        <result column="description" property="description"/>
        <result column="git_ssh_url" property="gitSshUrl"/>
        <result column="repo_id" property="repoId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, app_name, programming_language, description, git_ssh_url, repo_id, create_time, update_time, deleted
    </sql>

    <!-- 自定义查询不会被 MyBatis-Plus 逻辑删除插件自动追加 deleted 条件，需手动指定 deleted = 0 -->
    <select id="selectByAppName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM app_info
        WHERE deleted = 0
          AND app_name = #{appName}
        LIMIT 1
    </select>

    <select id="countByAppName" resultType="long">
        SELECT COUNT(*)
        FROM app_info
        WHERE deleted = 0
          AND app_name = #{appName}
        <if test="excludeId != null">
            AND id &lt;&gt; #{excludeId}
        </if>
    </select>

    <!-- 分页由 MyBatis-Plus 分页插件自动改写，这里无需手写 LIMIT -->
    <!--
        排序字段使用 ${} 拼接：sortField 为 Service 层白名单映射后的 snake_case 列名，
        sortOrder 限定为 asc / desc，均不可由前端直接控制，杜绝 SQL 注入。
    -->
    <select id="pageQuery" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM app_info
        <where>
            deleted = 0
            <if test="appName != null and appName != ''">
                AND app_name LIKE CONCAT('%', #{appName}, '%')
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="sortField != null and sortField != ''">
                ${sortField} ${sortOrder}, id DESC
            </when>
            <otherwise>
                id DESC
            </otherwise>
        </choose>
    </select>

</mapper>
